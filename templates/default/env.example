# Copy to .env and adjust. Every value below has a working default in app.ts,
# so the project runs without this file — but do not ship these keys.

APP_ID={{APP_ID}}
MASTER_KEY={{MASTER_KEY}}
MAINTENANCE_KEY={{MAINTENANCE_KEY}}

# Where MongoDB lives.
#   docker compose up -d   →  the URI below works as-is
#   MongoDB Atlas          →  paste your connection string here
#
# Transactions and @ParseVersionField need a REPLICA SET. The bundled
# docker-compose.yml provides one; a plain `mongod` install does not.
DATABASE_URI=mongodb://localhost:27017/{{PROJECT_NAME}}

PORT=1337
MOUNT_PATH=/api

# Must be the URL clients actually reach, or file links and password-reset
# emails will point somewhere unreachable.
# SERVER_URL=http://localhost:1337/api

# --- seeding ---------------------------------------------------------------
# src/seed.ts creates the Editor and Admin roles and the first admin user.
# It is idempotent, so re-running it changes nothing.
#
# On boot it runs automatically unless NODE_ENV=production. Set this to force
# it either way — `false` in development if you are testing a cold start,
# `true` in production if you would rather not add a deploy step.
# SEED_ON_BOOT=true

# The first administrator. Without ADMIN_PASSWORD the seed uses a known default
# and the server warns on every boot. Set it before this leaves your machine.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=

# --- API documentation -----------------------------------------------------
# OpenAPI docs are generated from your decorators and served at /api-docs, with
# the raw spec always at /api-docs/json. On by default, including in production:
# the document describes only the endpoints you declared, from the same
# decorators that enforce them, so it cannot drift into revealing something that
# is not there.
#
# Turn it off if your API is not public and you would rather not publish its
# shape. It is not access control either way - hiding the map is not locking the
# door.
# DOCS_ENABLED=false
# DOCS_PATH=/api-docs
# --- admin dashboard -------------------------------------------------------
# Parse Dashboard is NOT installed by default - it is a bundled React app and
# plenty of services never expose one. To get it:
#
#   npm install parse-dashboard
#
# Restart and it appears at /dashboard. Nothing else to configure.
#
# It holds the master key, so it is a full read/write console for your whole
# database. Unset in development it opens to admin / change-me-now and warns;
# unset in production it refuses to mount at all.
DASHBOARD_USER=admin
# DASHBOARD_PASS=
